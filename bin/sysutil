#!/bin/bash
# sysutil - System Utility Script für Arch Linux
# Konsolidierte Diagnose- und Setup-Tools

set -e

show_help() {
    cat << 'EOF'
sysutil - System Utilities

Usage: sysutil <command> [options]

Commands:
  nvidia-diag      Nvidia Treiber Diagnose
  nvidia-setup     Nvidia Treiber konfigurieren (sudo)
  rdp-diag         RDP/xrdp Diagnose
  rdp-fix          RDP Konfiguration reparieren (sudo)
  rdp-setup        Remote Desktop komplett einrichten (sudo)
  vnc-setup        VNC Server einrichten
  arch-setup       Arch Linux Shell Setup (zsh, p10k, tools)
  ndi-install      NDI SDK installieren

Examples:
  sysutil nvidia-diag
  sudo sysutil nvidia-setup
  sysutil vnc-setup
EOF
}

nvidia_diag() {
    echo "=== Nvidia Diagnose ==="
    echo "1. Nvidia Module laden..."
    sudo modprobe nvidia 2>/dev/null && echo "   OK" || echo "   FEHLER"
    sudo modprobe nvidia_modeset nvidia_uvm nvidia_drm 2>/dev/null
    echo "2. Geladene Module:"
    lsmod | grep nvidia || echo "   Keine nvidia Module geladen"
    echo "3. PCI Geräte:"
    lspci | grep -iE 'vga|nvidia'
    echo "4. nvidia-smi:"
    nvidia-smi 2>/dev/null || echo "   nvidia-smi nicht verfügbar"
}

nvidia_setup() {
    [[ $EUID -ne 0 ]] && { echo "Benötigt sudo"; exit 1; }
    echo "=== Nvidia Setup ==="
    cat > /etc/modprobe.d/nvidia.conf << 'CONF'
blacklist nouveau
options nouveau modeset=0
CONF
    cat > /etc/modprobe.d/nvidia-drm.conf << 'CONF'
options nvidia-drm modeset=1
CONF
    cp /etc/mkinitcpio.conf /etc/mkinitcpio.conf.bak
    sed -i 's/^MODULES=(btrfs)$/MODULES=(btrfs nvidia nvidia_modeset nvidia_uvm nvidia_drm)/' /etc/mkinitcpio.conf
    mkinitcpio -P
    echo "Fertig. Neustart erforderlich."
}

rdp_diag() {
    echo "=== RDP Diagnose ==="
    echo "[1] xrdp-sesman.log:"
    sudo tail -30 /var/log/xrdp-sesman.log 2>/dev/null || echo "Log nicht gefunden"
    echo "[2] .xsession-errors:"
    cat ~/.xsession-errors 2>/dev/null || echo "Keine Fehler"
    echo "[3] startwm.sh:"
    ls -la /etc/xrdp/startwm.sh 2>/dev/null
    echo "[4] Desktop verfügbar:"
    which startxfce4 xfce4-session 2>/dev/null || echo "XFCE nicht gefunden"
}

rdp_fix() {
    [[ $EUID -ne 0 ]] && { echo "Benötigt sudo"; exit 1; }
    echo "=== RDP Fix ==="
    cp /etc/xrdp/startwm.sh /etc/xrdp/startwm.sh.bak 2>/dev/null || true
    cat > /etc/xrdp/startwm.sh << 'STARTWM'
#!/bin/bash
exec > /tmp/xrdp-session-$USER.log 2>&1
unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
export XDG_SESSION_TYPE=x11 GDK_BACKEND=x11
[ -r /etc/default/locale ] && . /etc/default/locale && export LANG LANGUAGE
[ -z "$DBUS_SESSION_BUS_ADDRESS" ] && eval $(dbus-launch --sh-syntax)
exec startxfce4
STARTWM
    chmod +x /etc/xrdp/startwm.sh
    systemctl restart xrdp xrdp-sesman
    echo "Fertig. Log: /tmp/xrdp-session-$USER.log"
}

rdp_setup() {
    [[ $EUID -ne 0 ]] && { echo "Benötigt sudo"; exit 1; }
    echo "=== RDP/VNC Setup ==="
    pacman -S --needed --noconfirm xrdp tigervnc xorg-server-xephyr xterm
    rdp_fix
    systemctl enable --now xrdp xrdp-sesman
    echo "RDP auf Port 3389 aktiv"
}

vnc_setup() {
    echo "=== VNC Setup ==="
    mkdir -p ~/.vnc
    [ ! -f ~/.vnc/passwd ] && { echo "VNC Passwort setzen:"; vncpasswd; }
    cat > ~/.vnc/xstartup << 'XSTART'
#!/bin/bash
unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
export XDG_SESSION_TYPE=x11 GDK_BACKEND=x11
[ -z "$DBUS_SESSION_BUS_ADDRESS" ] && eval $(dbus-launch --sh-syntax)
exec startxfce4
XSTART
    chmod +x ~/.vnc/xstartup
    vncserver -kill :1 2>/dev/null || true
    vncserver :1 -geometry 1920x1080 -depth 24 -localhost no
    IP=$(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v 127 | head -1)
    echo "VNC aktiv auf $IP:5901"
}

arch_setup() {
    echo "=== Arch Shell Setup ==="
    sudo pacman -Syu --noconfirm
    sudo pacman -S --needed --noconfirm zsh git curl lsd bat fd ripgrep zoxide btop
    [ ! -d ~/powerlevel10k ] && git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k
    grep -q powerlevel10k ~/.zshrc || echo 'source ~/powerlevel10k/powerlevel10k.zsh-theme' >> ~/.zshrc
    grep -q 'alias ls=' ~/.zshrc || cat >> ~/.zshrc << 'ALIASES'
alias ls='lsd' ll='lsd -l' la='lsd -la' cat='bat'
eval "$(zoxide init zsh)"
ALIASES
    chsh -s $(which zsh)
    echo "Fertig. Terminal neu starten."
}

ndi_install() {
    echo "=== NDI SDK Install ==="
    TMP=$(mktemp -d)
    cd "$TMP"
    curl -L "https://downloads.ndi.tv/SDK/NDI_SDK_Linux/Install_NDI_SDK_v6_Linux.tar.gz" -o ndi.tar.gz
    tar -xzf ndi.tar.gz
    yes | PAGER="cat" sh Install_NDI_SDK_v6_Linux.sh
    mv "NDI SDK for Linux" ndisdk
    sudo cp -P ndisdk/lib/x86_64-linux-gnu/* /usr/local/lib/
    sudo ldconfig
    sudo ln -sf /usr/local/lib/libndi.so.6 /usr/local/lib/libndi.so.5
    rm -rf "$TMP"
    echo "NDI installiert in /usr/local/lib"
}

case "${1:-help}" in
    nvidia-diag)  nvidia_diag ;;
    nvidia-setup) nvidia_setup ;;
    rdp-diag)     rdp_diag ;;
    rdp-fix)      rdp_fix ;;
    rdp-setup)    rdp_setup ;;
    vnc-setup)    vnc_setup ;;
    arch-setup)   arch_setup ;;
    ndi-install)  ndi_install ;;
    *)            show_help ;;
esac
